# DTCWriter Proxy Server — Environment Variables
# Copy this to .env and fill in your values

# Server port (default: 3000)
PORT=3000

# Session secret — CHANGE THIS in production!
SESSION_SECRET=dtcwriter-change-this-secret-in-production

# (Optional) If you add a database later, connection string goes here
# DATABASE_URL=postgres://user:pass@localhost:5432/dtcwriter

# Optional production bootstrap for Render. Store real values as secret
# environment variables in the Render dashboard, not in Git.
PROXY_TARGET_URL=https://your-owned-second-site.example
PROXY_MODE=server
PROXY_COOKIES_JSON=[]
PROXY_HEADERS_JSON={}
PROXY_STRIP_HEADERS_JSON=["x-frame-options","content-security-policy","x-xss-protection","strict-transport-security"]
